# 복사해서 .env.local 로 사용. 실제 값은 팀 비공개 채널로만 공유.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 래블업 LLM API (서버 전용, NEXT_PUBLIC_ 금지). 호출 코드: src/lib/ai/llm.ts
# 키는 Continuum Hub > 연결 > "키 발급" 때 한 번만 보이는 값 (chk_...). 화면의 "키 ID"(key_...)는 키가 아님
LABLUP_API_BASE_URL=
LABLUP_API_KEY=
LABLUP_MODEL=DeepSeek-V4.1-Flash-B300
# true면 녹화된 LLM 응답 사용 (발표용 안전장치)
# 인터뷰: src/lib/interview/fixtures · 보고서: src/lib/report/fixtures
DEMO_MODE=false
# 점주 대체 시급(원) — 조정 영업이익 계산용
OWNER_HOURLY_WAGE=12000
